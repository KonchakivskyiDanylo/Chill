node_modules
dist
.idea
*.local
# The analytics server's local file store (`npm run api` without DATABASE_URL).
server/.data

# The Liquipedia dump stays out of git, except the files the site reads at
# build time. A deploy builds from the repo, so without these every game ships
# with no data.
#
# This used to ignore `liquipedia_data/` outright and then re-include three
# files with `!` lines. Git cannot re-include a file inside an excluded folder,
# so those lines never took effect and none of the data was ever committed.
# Each level has to be opened in turn, as below.
liquipedia_data/*
!liquipedia_data/clean_data/
liquipedia_data/clean_data/*
!liquipedia_data/clean_data/fortnite/
liquipedia_data/clean_data/fortnite/*
!liquipedia_data/clean_data/fortnite/players.json
!liquipedia_data/clean_data/fortnite/career_path.json
!liquipedia_data/clean_data/fortnite/teammates.json
!liquipedia_data/clean_data/fortnite/orgs.json
!liquipedia_data/clean_data/fortnite/facts.json
!liquipedia_data/clean_data/fortnite/rankings.json
!liquipedia_data/clean_data/fortnite/pools.json
